# Kopiere diese Datei nach .env.local und trage echte Werte ein.
# Neue VAPID-Schlüssel erzeugst du mit:  npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# Zufälliges Geheimnis, das die drei Cron-Routen schützt (Erinnerungen, Wiki, Kalender)
CRON_SECRET=

# Nur in der Cloud: echter Postgres. Lokal leer lassen, dann läuft PGlite.
DATABASE_URL=

# Google Kalender — ohne die ersten drei ist die Funktion aus
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32 — wer ihn wechselt, muss neu verbinden
GOOGLE_TOKEN_KEY=
# Nur lokal; im Betrieb weglassen (dann gilt die Funnel-Adresse)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# IServ — nur lesen; ohne die ersten vier ist die Funktion aus (README, „IServ“).
# Das Passwort in einfachen Anführungszeichen, ohne ' und ohne Zeilenumbruch.
# Lokal schreibt ein Abruf ins echte Google-Konto, und jede Anmeldung steht in
# den „Letzten Anmeldungen“ des Schülers.
ISERV_URL=
ISERV_USER=
ISERV_PASSWORD=
# 1–13, zum Schuljahr anheben
ISERV_KLASSE=
# Titelteile, mit ; getrennt — AUCH holt hinein, NIE hält draußen (schlägt AUCH)
ISERV_AUCH=
ISERV_NIE=
# Nur, wenn die Erkennung des Klassenkalenders nicht eindeutig ist: /<gruppe>/calendar
ISERV_KLASSENKALENDER=
