# Kopiere diese Datei nach .env.local und trage echte Werte ein.
# Neue VAPID-Schlüssel erzeugst du mit:  npx web-push generate-vapid-keys

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:du@example.com

# Zufälliges Geheimnis, das die Erinnerungs-Route schützt
CRON_SECRET=

# Nur in der Cloud: echter Postgres. Lokal leer lassen, dann läuft PGlite.
DATABASE_URL=

# Nur nötig, wenn die App unter mehreren Adressen erreichbar ist oder hinter
# etwas steht, das Host und Protokoll nicht durchreicht. Sonst leer lassen —
# dann liest der Server die Adresse aus der Anfrage. In der Cloud lohnt es
# sich trotzdem: der Ursprungsvergleich am MCP-Endpunkt hat damit eine Seite,
# die keine Anfrage bewegen kann.
APP_URL=

# Fester Bearer-Token für den MCP-Endpunkt: der Weg für Claude Code und für
# einen Versuch mit curl. Die Claude-App braucht ihn nicht, sie meldet sich
# über OAuth an. Leer lassen heißt: diesen Weg gibt es nicht.
#   claude mcp add --transport http schulapp http://localhost:3000/api/mcp \
#     --header "Authorization: Bearer <MCP_TOKEN>"
MCP_TOKEN=
